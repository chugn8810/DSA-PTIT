#include <bits/stdc++.h>
using namespace std;
int main()
{
    int m, tmp = 1;
    cin >> m;
    vector<int> a(m);
    for (int i = 0; i < m; i++)
    {
        cin >> a[i];
    }
    for (int i = 0; i < m; i++)
    {
        int check = 0;
        for (int j = 0; j < m - i - 1; j++)
        {
            if (a[j] > a[j + 1])
            {
                swap(a[j], a[j + 1]);
                check = 1;
            }
        }
        if (check == 0)
            break;
        cout << "Buoc " << tmp++ << ": ";
        for (int k = 0; k < m; k++)
        {
            cout << a[k] << " ";
        }
        cout << endl;
    }
}
